From 98335742a66aa3ebe54db727fba21f9063b3d2b5 Mon Sep 17 00:00:00 2001
From: Domenico Acri <support@engicam.com>
Date: Fri, 25 Sep 2026 10:41:14 +0200
Subject: [PATCH] added support usb j8 with ptn5150 i2c driver

---
 .../dts/mediatek/mt8391-genio-720-tia.dts     | 175 +++++++++---------
 1 file changed, 85 insertions(+), 90 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt8391-genio-720-tia.dts b/arch/arm64/boot/dts/mediatek/mt8391-genio-720-tia.dts
index 67934dc73b72..db8095e59a23 100755
--- a/arch/arm64/boot/dts/mediatek/mt8391-genio-720-tia.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8391-genio-720-tia.dts
@@ -138,54 +138,46 @@ usb0_en: regulator-3 {
 		regulator-name = "usb0_en";
 		regulator-min-microvolt = <5000000>;
 		regulator-max-microvolt = <5000000>;
-		gpio = <&pio 82 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		gpio = <&pio 82 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
-		gpio-open-drain;
 		regulator-always-on;
 	};
 
-	usb1_en: regulator-4 {
-		compatible = "regulator-fixed";
-		regulator-name = "usb1_en";
-		regulator-min-microvolt = <5000000>;
-		regulator-max-microvolt = <5000000>;
-		gpio = <&pio 84 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
-		enable-active-high;
-		gpio-open-drain;
-		regulator-always-on;
-	};
+	usb_con_p0: connector {
+		compatible = "usb-c-connector";
+		label = "USB-C";
+		data-role = "dual";
+		power-role = "dual";
+		try-power-role = "sink";
+		source-pdos = <PDO_FIXED(5000, 500, PDO_FIXED_DUAL_ROLE |
+					PDO_FIXED_USB_COMM |
+					PDO_FIXED_DATA_SWAP)>;
+		sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_DUAL_ROLE |
+					PDO_FIXED_USB_COMM |
+					PDO_FIXED_DATA_SWAP)>;
+		op-sink-microwatt = <10000000>;
+
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
 
-	usb2_en: regulator-5 {
-		compatible = "regulator-fixed";
-		regulator-name = "usb2_en";
-		regulator-min-microvolt = <5000000>;
-		regulator-max-microvolt = <5000000>;
-		gpio = <&pio 86 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
-		enable-active-high;
-		gpio-open-drain;
-		regulator-always-on;
-	};
+			port@0 {
+				reg = <0>;
 
-	usb3_en: regulator-6 {
-		compatible = "regulator-fixed";
-		regulator-name = "usb3_en";
-		regulator-min-microvolt = <5000000>;
-		regulator-max-microvolt = <5000000>;
-		gpio = <&pio 85 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
-		enable-active-high;
-		gpio-open-drain;
-		regulator-always-on;
-	};
+				usb_c_0_hs_ep: endpoint {
+					remote-endpoint = <&ssusb_0_hs_ep>;
+				};
+			};
 
-	usb4_en: regulator-7 {
-		compatible = "regulator-fixed";
-		regulator-name = "usb4_en";
-		regulator-min-microvolt = <5000000>;
-		regulator-max-microvolt = <5000000>;
-		gpio = <&pio 87 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
-		enable-active-high;
-		gpio-open-drain;
-		regulator-always-on;
+			port@1 {
+				reg = <1>;
+
+				usb_c_0_ss_ep: endpoint {
+					remote-endpoint = <&ptn5150_in_ep>;
+				};
+			};
+		};
 	};
 };
 
@@ -884,35 +876,15 @@ pins-otg-id {
 			input-enable;
 		};
 		pins-usb0-oc-pins {
-			pinmux = <PINMUX_GPIO5__FUNC_GPIO5>;
-			input-enable;
-		};
-	};
-
-	usb1_default_pins: usb1-default-pins {
-		pins-usb1-oc-pins {
-			pinmux = <PINMUX_GPIO6__FUNC_GPIO6>;
-			input-enable;
-		};
-	};
-
-	usb2_default_pins: usb2-default-pins {
-		pins-usb2-oc {
-			pinmux = <PINMUX_GPIO7__FUNC_GPIO7>;
-			input-enable;
-		};
-	};
-
-	usb3_default_pins: usb3-default-pins {
-		pins-usb3-oc {
-			pinmux = <PINMUX_GPIO8__FUNC_GPIO8>;
+			pinmux = <PINMUX_GPIO79__FUNC_GPIO79>;
 			input-enable;
 		};
 	};
 
-	usb4_default_pins: usb4-default-pins {
-		pins-usb4-oc {
-			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
+	cc_connector_pins: cc-connector-pins {
+		pins-int {
+			pinmux = <PINMUX_GPIO114__FUNC_GPIO114>;
+			bias-pull-up;
 			input-enable;
 		};
 	};
@@ -1034,41 +1006,43 @@ &ssusb {
 	wakeup-source;
 	vusb33-supply = <&mt6359_vusb_ldo_reg>;
 	status = "okay";
+
+	port {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ssusb_0_hs_ep: endpoint@0 {
+			reg = <0>;
+			remote-endpoint = <&usb_c_0_hs_ep>;
+		};
+
+		ssusb_0_ss_ep: endpoint@1 {
+			reg = <1>;
+			remote-endpoint = <&ptn5150_out_ep>;
+		};
+	};
 };
 
 &xhci1 {
-	pinctrl-names = "default";
-	pinctrl-0 = <&usb1_default_pins>;
 	wakeup-source;
 	vusb33-supply = <&mt6359_vusb_ldo_reg>;
-	vbus-supply = <&usb1_en>;
 	status = "okay";
 };
 
 &xhci2 {
-	pinctrl-names = "default";
-	pinctrl-0 = <&usb2_default_pins>;
 	wakeup-source;
 	vusb33-supply = <&mt6359_vusb_ldo_reg>;
-	vbus-supply = <&usb3_en>;
 	status = "okay";
 };
 
 &xhci3 {
-	pinctrl-names = "default";
-	pinctrl-0 = <&usb3_default_pins>;
 	wakeup-source;
 	vusb33-supply = <&mt6359_vusb_ldo_reg>;
-	vbus-supply = <&usb2_en>;
 	status = "okay";
 };
 
 &xhci4 {
-	pinctrl-names = "default";
-	pinctrl-0 = <&usb4_default_pins>;
 	wakeup-source;
-	vusb33-supply = <&mt6359_vusb_ldo_reg>;
-	vbus-supply = <&usb4_en>;
 	status = "okay";
 };
 
@@ -1076,6 +1050,38 @@ &i2c0{
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c0_pins>;
 	status = "okay";
+
+	ptn5150@3d {
+		compatible = "nxp,ptn5150";
+		reg = <0x3d>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cc_connector_pins>;
+		status = "okay";
+
+		interrupt-parent = <&pio>;
+		interrupts = <114 IRQ_TYPE_LEVEL_LOW>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				ptn5150_in_ep: endpoint {
+					remote-endpoint = <&usb_c_0_ss_ep>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				ptn5150_out_ep: endpoint {
+					remote-endpoint = <&ssusb_0_ss_ep>;
+				};
+			};
+		};
+	};
 };
 
 &i2c1{
@@ -1121,17 +1127,6 @@ &i2c8{
 	status = "okay";
 };
 
-&ssusb {
-	maximum-speed = "high-speed";
-
-	usb_con_p0: connector {
-		compatible = "gpio-usb-b-connector", "usb-b-connector";
-		type = "micro";
-		id-gpios = <&pio 81 GPIO_ACTIVE_HIGH>;
-		vbus-supply = <&usb0_en>;
-	};
-};
-
 &eth {
 	phy-mode ="rgmii-rxid";
 	phy-handle = <&phy>;
-- 
2.43.0

