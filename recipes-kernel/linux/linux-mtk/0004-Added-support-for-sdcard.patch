From 34829b03ac4be46963d708b6d1a049104bd2db01 Mon Sep 17 00:00:00 2001
From: engicam <support@engicam.com>
Date: Tue, 28 Apr 2026 14:31:26 +0200
Subject: [PATCH] Added support for sdcard

---
 .../boot/dts/mediatek/mt8391-genio-720-smarcore-evb.dts   | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt8391-genio-720-smarcore-evb.dts b/arch/arm64/boot/dts/mediatek/mt8391-genio-720-smarcore-evb.dts
index 72d4d7539a11..18351fcecdb4 100755
--- a/arch/arm64/boot/dts/mediatek/mt8391-genio-720-smarcore-evb.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8391-genio-720-smarcore-evb.dts
@@ -563,7 +563,7 @@ pins-clk {
 			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
 		};
 		pins-insert {
-			pinmux = <PINMUX_GPIO2__FUNC_GPIO2>;
+			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
 			bias-pull-up;
 		};
 	};
@@ -1164,13 +1164,11 @@ &mmc1 {
 	pinctrl-0 = <&mmc1_pins_default>;
 	pinctrl-1 = <&mmc1_pins_uhs>;
 	bus-width = <4>;
-	max-frequency = <200000000>;
+	max-frequency = <50000000>;
 	cap-sd-highspeed;
-	sd-uhs-sdr50;
-	sd-uhs-sdr104;
 	no-mmc;
 	no-sdio;
-	cd-gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
+	cd-gpios = <&pio 3 GPIO_ACTIVE_LOW>;
 	vmmc-supply = <&mt6359_vpa_buck_reg>;
 	vqmmc-supply = <&mt6359_vsim1_ldo_reg>;
 };
-- 
2.43.0

