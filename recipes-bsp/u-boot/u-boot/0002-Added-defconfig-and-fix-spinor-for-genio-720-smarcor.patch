From 83472cdce274cf0f2d412a361062c5007d4d1293 Mon Sep 17 00:00:00 2001
From: engicam <support@engicam.com>
Date: Wed, 10 Jun 2026 09:43:16 +0200
Subject: [PATCH] Added defconfig and fix spinor for genio 720 smarcore evb ufs
 qspi

---
 arch/arm/dts/genio-720-evk-ufs-qspi.dts       |   2 +-
 .../genio_720_smarcore_evb_ufs_qspi_defconfig | 139 ++++++++++++++++++
 drivers/mtd/spi/spi-nor-ids.c                 |   4 +-
 3 files changed, 142 insertions(+), 3 deletions(-)
 create mode 100644 configs/genio_720_smarcore_evb_ufs_qspi_defconfig

diff --git a/arch/arm/dts/genio-720-evk-ufs-qspi.dts b/arch/arm/dts/genio-720-evk-ufs-qspi.dts
index 07aa33ca1a..11483057b0 100644
--- a/arch/arm/dts/genio-720-evk-ufs-qspi.dts
+++ b/arch/arm/dts/genio-720-evk-ufs-qspi.dts
@@ -46,7 +46,7 @@
 		compatible = "jedec,spi-nor";
 		reg = <0>;
 		spi-tx-bus-width = <1>;
-		spi-rx-bus-width = <4>;
+		spi-rx-bus-width = <1>;
 		u-boot,dm-pre-reloc;
 	};
 };
